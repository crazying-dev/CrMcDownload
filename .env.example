# CrMcDownload 镜像服务运行配置模板：复制为 .env 后按需修改。
# 说明：应用只读 os.environ，不解析本文件；由部署层把这里的环境变量注入进程
#（systemd 的 EnvironmentFile，或 run.sh 里的 `set -a; . ./.env; set +a`）。
# 留空/缺省 = 用代码默认值。

MIRROR_LISTEN=127.0.0.1:8081
MIRROR_CACHE_DIR=/var/lib/offcraft-mirror
MIRROR_TOKEN=change-me-to-a-random-token
MIRROR_METADATA_TTL=600
UV_CACHE_DIR=/var/lib/offcraft-mirror/uv-cache

# 持久数据根目录：数据库 / 皮肤 / 官方插件包 / 热门种子都在这里，不存在会自动创建。
# 相对路径按进程工作目录解析（默认与 server/ 同级的 db/CrMcDownload）。
MIRROR_DATA_DIR=../db/CrMcDownload
# 也可单独覆盖各子路径：
# MIRROR_DB_PATH=../db/CrMcDownload/mirror.db
# MIRROR_SKINS_DIR=../db/CrMcDownload/skins
# MIRROR_POPULAR_DATA=../db/CrMcDownload/popular_servers.json

# 上游（默认官方；如服务器无法直连可改）
# UPSTREAM_META=https://piston-meta.mojang.com
# UPSTREAM_DATA=https://piston-data.mojang.com
# UPSTREAM_LIBS=https://libraries.minecraft.net
# UPSTREAM_ASSETS=https://resources.download.minecraft.net
# UPSTREAM_FABRIC=https://meta.fabricmc.net
# UPSTREAM_FABRICMAVEN=https://maven.fabricmc.net
# UPSTREAM_FORGEMAVEN=https://maven.minecraftforge.net
# UPSTREAM_NEOFORGEMAVEN=https://maven.neoforged.net
# UPSTREAM_MODRINTH=https://api.modrinth.com
# UPSTREAM_MODCDN=https://cdn.modrinth.com

# 上游代理（可选）
# UPSTREAM_PROXY=socks5h://127.0.0.1:1080

# --- 离线联机（P2P）：不设这几项则 /p2p/* 返回 404「离线联机未启用」 ---
MIRROR_P2P_ENABLE=on
# 中继对外通告地址（空则回落监听地址，公网不可达）
MIRROR_P2P_RELAY_HOST=mc.yjlt.top
# 数据面裸 TCP 端口，需在云安全组/防火墙单独放行
MIRROR_P2P_RELAY_PORT=25577
# MIRROR_P2P_MAX_ROOMS=256
# MIRROR_P2P_MAX_ROOMS_PER_DEVICE=10
# MIRROR_P2P_ROOM_TTL=180
# MIRROR_P2P_RELAY_BYTES_CAP=536870912

# --- 官方特权插件按需下载：GET /plugin/* 从此目录读取 ---
MIRROR_PLUGIN_DIR=../db/CrMcDownload/plugins
