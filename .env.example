MIRROR_LISTEN=127.0.0.1:8081
MIRROR_CACHE_DIR=/var/lib/offcraft-mirror
MIRROR_TOKEN=change-me-to-a-random-token
MIRROR_METADATA_TTL=600
UV_CACHE_DIR=/var/lib/offcraft-mirror/uv-cache

# 上游（默认官方；如服务器无法直连可改）
# UPSTREAM_META=https://piston-meta.mojang.com
# UPSTREAM_DATA=https://piston-data.mojang.com
# UPSTREAM_LIBS=https://libraries.minecraft.net
# UPSTREAM_ASSETS=https://resources.download.minecraft.net
# UPSTREAM_FABRIC=https://meta.fabricmc.net
# UPSTREAM_FABRICMAVEN=https://maven.fabricmc.net
# UPSTREAM_MODRINTH=https://api.modrinth.com
# UPSTREAM_MODCDN=https://cdn.modrinth.com

# 上游代理（可选）
# UPSTREAM_PROXY=socks5h://127.0.0.1:1080
